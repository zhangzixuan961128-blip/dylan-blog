---
import { getLangFromUrl, getLocalizedPath, languages, useTranslations } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const targetLang = lang === 'zh' ? 'en' : 'zh';
const switchPath = getLocalizedPath(Astro.url, targetLang);
---

<a href={switchPath} class="lang-toggle" title={`Switch to ${languages[targetLang]}`}>
  {languages[targetLang]}
</a>

<style>
  .lang-toggle {
    font-size: 0.8rem;
    font-weight: 500;
    padding: 0.3rem 0.65rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    color: var(--gray-500);
    text-decoration: none;
    transition: all 0.15s;
    cursor: pointer;
  }
  .lang-toggle:hover {
    color: var(--accent);
    border-color: var(--accent);
    background: var(--accent-light);
  }
</style>
