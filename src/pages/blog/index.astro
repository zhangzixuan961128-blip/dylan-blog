---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';
import { getLangFromUrl, useTranslations, formatDate } from '../../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<!doctype html>
<html lang={lang}>
  <head>
    <BaseHead title={t('posts.all')} description={SITE_TITLE} />
  </head>
  <body>
    <Header />
    <main class="page-blog">
      <h1>{t('posts.all')}</h1>
      {posts.length > 0 ? (
        <div class="post-grid">
          {posts.map((post) => (
            <a href={`/blog/${post.id}/`} class="post-card">
              {post.data.heroImage && (
                <div class="post-thumb">
                  <Image width={480} height={240} src={post.data.heroImage} alt="" />
                </div>
              )}
              <div class="post-info">
                <div class="post-header">
                  <h3 class="post-title">{post.data.title}</h3>
                  {post.data.lang && post.data.lang !== lang && (
                    <span class="post-lang-badge">{post.data.lang === 'zh' ? '中文' : 'EN'}</span>
                  )}
                </div>
                <p class="post-desc">{post.data.description}</p>
                <time class="post-date">{formatDate(post.data.pubDate, post.data.lang as 'zh' | 'en')}</time>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <p class="empty">{t('posts.empty')}</p>
      )}
    </main>
    <Footer />
  </body>
</html>

<style>
  .page-blog {
    max-width: 960px;
    margin: 0 auto;
    padding: 2.5rem 1.5rem;
  }
  .page-blog h1 {
    font-size: 1.5rem;
    margin-bottom: 1.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border);
  }
  .post-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  .post-card {
    display: block;
    padding: 1.25rem;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--text);
    transition: all 0.15s;
  }
  .post-card:hover {
    border-color: var(--gray-300);
    box-shadow: var(--shadow);
  }
  .post-card:hover .post-title {
    color: var(--accent);
  }
  .post-thumb {
    margin-bottom: 0.75rem;
    border-radius: 6px;
    overflow: hidden;
  }
  .post-thumb img {
    width: 100%;
    display: block;
  }
  .post-info {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .post-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .post-title {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--text-heading);
    margin: 0;
    transition: color 0.15s;
  }
  .post-lang-badge {
    font-size: 0.7rem;
    font-weight: 500;
    padding: 0.1rem 0.45rem;
    background: var(--gray-100);
    color: var(--gray-500);
    border-radius: 4px;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .post-desc {
    font-size: 0.875rem;
    color: var(--gray-500);
    line-height: 1.5;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .post-date {
    font-size: 0.8rem;
    color: var(--gray-400);
    margin-top: 0.25rem;
  }
  .empty {
    color: var(--gray-400);
    text-align: center;
    padding: 4rem 0;
  }
  @media (max-width: 768px) {
    .page-blog {
      padding: 1.5rem 1rem;
    }
  }
</style>
